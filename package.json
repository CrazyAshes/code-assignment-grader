{
  "name": "code-assignment-grader",
  "version": "1.0.0",
  "description": "Desktop app for grading Python and Java assignments with OpenAI",
  "main": "src/main/main.js",
  "config": {
    "forge": "./config/forge.config.js"
  },
  "scripts": {
    "dev": "concurrently \"vite --port 5199 --strictPort\" \"wait-on tcp:5199 && env -u ELECTRON_RUN_AS_NODE electron .\"",
    "build": "vite build",
    "start": "env -u ELECTRON_RUN_AS_NODE electron .",
    "clean": "rm -rf dist out release",
    "package": "electron-forge package",
    "make": "npm run build && electron-forge make",
    "release": "npm run build && electron-forge make --platform=darwin --arch=arm64",
    "release:win": "npm run build && electron-forge make --platform=win32 --arch=x64",
    "release:all": "npm run clean && npm run release && npm run release:win"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "openai": "^5.20.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "electron": "^37.4.0",
    "vite": "^7.1.7",
    "wait-on": "^8.0.5"
  }
}
